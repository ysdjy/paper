# Franka V1 Skill Lab — pi0.5 pipeline config (V1).
# Sourced by the 1_..5_ wrapper scripts. Overrides the legacy IK-Rel defaults
# with the V1 JOINT-action task.

# --- V1 contract -------------------------------------------------------------
V1_TASK_ID="Isaac-Stack-Cube-Franka-JointPolicy-v0"   # joint action (NOT IK-Rel)
V1_CONTROL_MODE="joint"
V1_REPO_ID="franka_v1_joint_demos"

# --- legacy pipeline location (real implementation) --------------------------
# Resolved relative to the IsaacLab repo root.
LEGACY_PI05_DIR="pi05_isaacsim_baseline"
LEGACY_WORKFLOW_DIR="pi05_isaacsim_baseline/WORKFLOW"

# --- policy server (OpenPI isolated; HTTP bridge only) -----------------------
POLICY_HOST="127.0.0.1"
POLICY_PORT="8008"
POLICY_BACKEND="mock"        # mock | openpi  (default mock — no GPU, no OpenPI)

# --- data (V1 workspace data root) -------------------------------------------
V1_DATA_ROOT="projects/franka_v1_skill_lab/data"
RAW_HDF5_DIR="$V1_DATA_ROOT/teleop_raw_hdf5"
LEROBOT_DIR="$V1_DATA_ROOT/lerobot"
TASK_CONFIG="projects/franka_v1_skill_lab/configs/teleop_tasks.yaml"

# --- training (do NOT auto-run long training) --------------------------------
TRAIN_STEPS="100"            # smoke value; real runs override
